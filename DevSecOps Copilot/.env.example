# SMTP provider settings used to deliver password reset PINs
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_FROM=DevSecOps Copilot <no-reply@example.com>

# Use a unique random value of at least 32 characters
RESET_PIN_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional; defaults to data/accounts.sqlite
# DATABASE_PATH=./data/accounts.sqlite
